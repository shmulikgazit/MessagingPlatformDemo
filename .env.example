# --- Account (required) ---
ACCOUNT_ID=a41244303

# --- Auth: pick ONE approach ---

# (A) Human agents (username + password) — SDK uses agentVep login (same stack as Conversational Cloud login)
# Do not commit real passwords. Use the web UI or set locally for `npm run connect-demo`.
LP_AUTH_MODE=password
#LPM_USERNAME=agenta
#LPM_PASSWORD=

# (B) App/bot user with OAuth 1.0 (six values). If all six exist in the environment, the server defaults
# to this mode unless you set LP_AUTH_MODE=password and use the UI to connect with a password.
# LPM_USERNAME=
# APP_KEY=
# APP_SECRET=
# ACCESS_TOKEN=
# ACCESS_TOKEN_SECRET=

# Optional: quick username buttons in the web UI (comma-separated)
LP_DEMO_USERNAMES=agenta,agentb

# HTTP server
PORT=3000

# Optional: proxy (Fiddler / corporate)
# PROXY_HOST=127.0.0.1
# PROXY_PORT=8888
# USE_FIDDLER=1

# Optional: only subscribe to one agent’s conversations (full id: accountId.userId)
# SUBSCRIPTION_AGENT_ID=

# Optional: GET_ALL_MESSAGES=true
# LP_APP_ID=messaging_platform_demo_workspace

# Optional: verbose LP notifications in SSE
# RAW_LP_NOTIFICATIONS=1
